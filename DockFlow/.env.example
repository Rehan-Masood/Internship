FLASK_ENV=development
SECRET_KEY=change-me
PORT=5000
APP_VERSION=1.0.0
APP_ENV=Development

# Optional GitHub Actions integration
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW=ci-cd.yml
GITHUB_REF=main

# Optional deployment provider
DEPLOYMENT_PROVIDER=
